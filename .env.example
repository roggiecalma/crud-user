# Railway sets these automatically once you attach a MySQL database to this
# service (Project -> New -> Database -> Add MySQL, then connect it to this
# service's variables). You don't need to set them by hand on Railway.
#
# Only needed if you ever run this app somewhere without Railway's MySQL
# plugin (e.g. a different host, or local dev): copy this file to .env-style
# exported vars, or edit the fallbacks directly in includes/config.php.

MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=railway
